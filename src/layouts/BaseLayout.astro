---
import '../styles/global.css';
import { site } from '../../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import Schema from '../components/Schema.astro';

interface Props {
  seoTitle: string;
  description: string;
  pageType?: 'home' | 'service' | 'town' | 'faq' | 'page';
  serviceName?: string;
  townName?: string;
  noindex?: boolean;
  faq?: { question: string; answer: string }[];
}

const { seoTitle, description, pageType = 'page', serviceName, townName, noindex = false, faq } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * The home hero photo sits behind a translucent brand-colored scrim, and a
 * translucent color needs its channels separately — you cannot put a hex into
 * rgba() and set the alpha from CSS. So the palette is also emitted as bare
 * "r, g, b" for the one place that needs it.
 *
 * Unlike the rest of the palette, this one required editing global.css. An
 * rgba(15, 82, 87, .85) literal cannot be overridden by a custom property; the
 * rule itself has to reference one. Those literals were Huntsville's teal, and
 * they would have painted the Kalamazoo hero band teal the moment a home hero
 * image was added — the same trap as the palette, one layer deeper.
 */
const rgbOf = (hex: string) => {
  const n = parseInt(hex.replace('#', ''), 16);
  return `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`;
};
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex
      ? 'noindex, follow'
      : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.business.name} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Schema
      pageType={pageType}
      name={seoTitle}
      description={description}
      url={canonical}
      serviceName={serviceName}
      townName={townName}
      faq={faq}
    />
    {/*
      Paint the palette from site.config.ts over global.css's defaults.

      Without this the `brand` block in the config is decorative — global.css
      hardcodes the previous market's colors and every clone ships looking
      identical to its parent. That is exactly what happened on the first
      Kalamazoo deploy: the site went live wearing Huntsville's teal and
      orange despite the config specifying graphite and blue.

      site.config.ts is meant to be the only file that changes between
      markets. This is the line that makes that true for color.

      The selector is `:root:root`, not `:root`, and that is deliberate.
      Astro bundles global.css and injects its <link> into the head AFTER
      this inline block. Both would be plain `:root` — same specificity —
      so global.css would win on source order and the config would be
      ignored, which is exactly what happened on the first attempt.
      Repeating the selector raises specificity to (0,2,0) and wins
      regardless of where Astro decides to put the stylesheet link.
      Verified in the live DOM before shipping.
    */}
    <style is:inline set:html={`:root:root{
      --primary:${site.brand.primary};
      --primary-rgb:${rgbOf(site.brand.primary)};
      --primary-dk:${site.brand.primaryDk};
      --red:${site.brand.red};
      --red-dk:${site.brand.redDk};
      --cta:${site.brand.red};
      --cta-dk:${site.brand.redDk};
      --marker:${site.brand.marker};
      --accent:${site.brand.accent};
      --ink:${site.brand.ink};
      --body:${site.brand.body};
      --surface:${site.brand.surface};
    }`}></style>
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      {/*
        The worker redirects to /contact/?sent=1 on a successful submission.
        Nothing read that flag until now, so a person who filled in the form was
        returned to a page that looked exactly like the one they had just
        submitted — no thank you, no acknowledgement. A fair number would have
        concluded it was broken. The site is static, so the flag has to be read
        client-side; the banner ships hidden and is revealed on load.
      */}
      <div class="wrap">
        <div class="sent-banner" id="sent-banner" role="status">
          <strong>Thanks — we have got that.</strong>
          <p>We will call you back shortly. If it is urgent, call us and we will pick up.</p>
        </div>
      </div>
      <slot />
    </main>
    <script is:inline>
      if (location.search.indexOf('sent=1') !== -1) {
        var b = document.getElementById('sent-banner');
        if (b) { b.classList.add('show'); b.scrollIntoView({ block: 'center' }); }
      }
    </script>
    <Footer />
    <CallBar />
  </body>
</html>
